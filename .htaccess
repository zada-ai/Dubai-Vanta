# Never show folder listings
Options -Indexes

# ----------------------------------------------------------------------
# 1. GZIP / DEFLATE COMPRESSION (Massive Speedup: ~75% smaller downloads)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ----------------------------------------------------------------------
# 2. BROWSER CACHING (mod_expires & Cache-Control for 90+ PageSpeed)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents - fresh check
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media files
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# 3. HTTP HEADERS: Security & Immutable Asset Caching
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Long-lived caching for built assets
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|jpg|jpeg|png|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must revalidate to get latest app versions
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Uploaded files are data only: SVGs cannot run scripts
  <FilesMatch "\.svg$">
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 4. URL REWRITES & SPA FALLBACK
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. SECURITY: block files that must never be downloadable from the web
  #    - hidden files/folders (.env, .git, .tmp, .htaccess ...), except .well-known
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
  #    - source code, server code, build tooling, dependencies, malware signatures
  RewriteRule ^(server|src|node_modules|init)(/|$) - [F,L,NC]
  RewriteRule ^(package(-lock)?\.json|vite\.config\.[cm]?js|app\.cjs|README\.md)$ - [F,L,NC]
  #    - database dumps, logs, spreadsheets, backups, config files
  RewriteRule \.(sql|sqlite3?|db|log|csv|xlsx?|bak|old|orig|swp|ini|conf|ya?ml|lock|sh|md)$ - [F,L,NC]
  #    - nothing executable may ever run from the upload folders
  RewriteRule ^(storage|uploads)/.*\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh|asp|aspx|jsp|js|mjs|html?|svgz)$ - [F,L,NC]
  #    - the only PHP file allowed to run is api.php (via the /api rewrite below)
  RewriteCond %{REQUEST_URI} !^/api\.php$
  RewriteRule \.(php[0-9]?|phtml|phar|pht)$ - [F,L,NC]

  # 1. Direct access to storage & uploads
  RewriteRule ^uploads/(.*)$ storage/uploads/$1 [L]
  RewriteRule ^storage/(.*)$ storage/$1 [L]

  # 2. Forward API requests to Node backend via api.php proxy
  RewriteRule ^api(/.*)?$ api.php [L,QSA]

  # 3. Serve real static files directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA fallback: Route all frontend page routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
