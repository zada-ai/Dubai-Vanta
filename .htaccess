<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct access to storage & uploads
  RewriteRule ^uploads/(.*)$ storage/uploads/$1 [L]
  RewriteRule ^storage/(.*)$ storage/$1 [L]

  # 2. Proxy API requests to Node.js backend on port 5000
  RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]

  # 3. Serve built files from dist/ if they exist
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 4. SPA fallback: Route all frontend page routes to dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/storage/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteRule ^ dist/index.html [L]
</IfModule>
