# ========================================================
# 🚀 AEROSTORE / DUBAI VANTA - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# JWT & Authentication Secrets (httpOnly Refresh Token)
JWT_ACCESS_SECRET=aerostore_access_secret_key_2026_secure
JWT_REFRESH_SECRET=aerostore_refresh_secret_key_2026_super_secure
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=24h

# ========================================================
# 👑 SUPER ADMIN CREDENTIALS (Login Access)
# ========================================================
SUPERADMIN_EMAIL=sohaibmehmood0067@gmail.com
SUPERADMIN_PASSWORD=sohaibmehmood0067@gmail.com
SUPERADMIN_NAME=Sohaib Mehmood
SUPERADMIN_ROLE=superadmin

# ========================================================
# 🗄️ DATABASE CONFIGURATION
# Yahan apni database ki details dalein:
# ========================================================

# 1. Database Type: sqlite | mysql | postgres
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aerostore_db
DB_USER=root
DB_PASSWORD=

# 3. Ya direct connection string URL (optional):
# DATABASE_URL=mysql://root:password@localhost:3306/aerostore_db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aerostore_db
DATABASE_URL=

# 4. SQLite local database file path:
DB_PATH=./server/data/store.db

# ========================================================
# 🌐 STORE & PAYMENT SETTINGS
# ========================================================
STORE_NAME=VANTA DUBAI
STORE_CURRENCY=AED
SITE_URL=http://localhost:5173
CASH_ON_DELIVERY_ENABLED=true